PORT=8600

# URL base do seu servidor (troque quando for pra produção)
BASE_URL=https://projectaempreendimentos.com.br/
FRONTEND_URL=https://projectaempreendimentos.com.br
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://projectaempreendimentos.com.br

# Se estiver em rede local, pode ser algo assim:
# BASE_URL=http://192.168.1.133:3500

# Variaveis obrigatorias para conexao local (ajuste conforme seu DB)
JWT_SECRET=dev-secret-please-change
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=senha
DB_NAME=projecta
DB_CONNECTION_LIMIT=5
